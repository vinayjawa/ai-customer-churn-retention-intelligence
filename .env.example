# Copy to .env and fill in values. Never commit .env.

# --- SQL Server (required for database ingestion) ---
# Server / instance, e.g. localhost\\SQLEXPRESS or myserver.database.windows.net,1433
CHURN_DB_SERVER=

# Target database (default in code: ChurnIntel)
CHURN_DB_NAME=ChurnIntel

# Authentication: windows | sql
CHURN_DB_AUTH=windows

# SQL authentication only (leave empty for Windows auth)
CHURN_DB_USER=
CHURN_DB_PASSWORD=

# ODBC driver name as installed on your machine
CHURN_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Set to yes for local/dev when using Driver 18 without a trusted cert
CHURN_TRUST_SERVER_CERTIFICATE=yes

# Optional: override full SQLAlchemy URL (takes precedence if set)
# CHURN_DATABASE_URL=mssql+pyodbc://...

# Ingestion defaults
CHURN_CSV_PATH=data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv
CHURN_INGEST_BATCH_SIZE=500

# Set to 1 to enable pytest integration tests against SQL Server
CHURN_DB_INTEGRATION=0
